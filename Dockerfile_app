FROM alpine:latest

RUN apk add --no-cache nginx && \
    mkdir -p /run/nginx /var/www/html && \
    echo "<h1>Application Deployed via Terraform IaC!</h1>" > /var/www/html/index.html

RUN printf 'server {\n  listen 80 default_server;\n  root /var/www/html;\n  index index.html;\n}\n' > /etc/nginx/http.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]